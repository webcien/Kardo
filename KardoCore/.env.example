# KardoCore Configuration Example
# Copy this file to .env and configure your values

# General
KARDO_DEBUG=false
KARDO_ENVIRONMENT=development

# Server
KARDO_HOST=127.0.0.1
KARDO_PORT=8000

# Security (IMPORTANT: Generate a secure random key for production!)
KARDO_SECRET_KEY=your-secret-key-here-minimum-32-characters-long-change-this
KARDO_ALLOWED_HOSTS=*

# Database
KARDO_DATABASE_URL=sqlite:///kardocore.db

# AI Configuration
KARDO_AI_ENABLED=true
KARDO_AI_PROVIDER=openai
KARDO_AI_API_KEY=your-openai-api-key-here
KARDO_AI_MODEL=gpt-4

# Themes
KARDO_THEME_FRONTEND=default
KARDO_THEME_ADMIN=default

# Cache
KARDO_CACHE_ENABLED=true
KARDO_CACHE_TTL=3600

# Logging
KARDO_LOG_LEVEL=INFO
KARDO_LOG_FILE=kardocore.log

